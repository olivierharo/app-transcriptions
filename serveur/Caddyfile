{$DOMAINE} {
	# Enregistrements longs : jusqu'a 2 Go par fichier
	request_body {
		max_size 2GB
	}
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy relais:8000 {
		# Envois lents depuis un telephone en 4G
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
	# Pas de journal d'acces : les URL des raccourcis contiennent une cle.
}
